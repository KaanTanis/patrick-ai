# OpenAI API anahtarı (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Kullanılacak model (gpt-4o, gpt-4o-mini, gpt-4.1, o4-mini, vb.)
PATRICK_MODEL=gpt-4o

# Otomatik onay modu (true/false). True ise tehlikeli komutlar için bile onay sormaz.
# Üretim makinelerinde KESİNLİKLE false bırakın.
PATRICK_AUTO_APPROVE=false

# Web UI portu (0 = web UI'ı başlatma)
PATRICK_WEB_PORT=7878

# Web UI'ı tarayıcıda otomatik aç (true/false)
PATRICK_WEB_OPEN=false
